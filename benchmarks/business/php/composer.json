{
  "name": "thinkgo/benchmark-php-tests",
  "description": "两个 PHP 框架共享业务合同的验证环境",
  "type": "project",
  "require": {"php": "^8.5", "ext-pdo": "*", "ext-pdo_pgsql": "*", "ext-redis": "*", "ext-mbstring": "*"},
  "require-dev": {"phpunit/phpunit": "13.4.6"},
  "autoload": {"psr-4": {"Benchmark\\Business\\": "shared/src/"}},
  "autoload-dev": {"psr-4": {"Benchmark\\Tests\\": "shared/tests/"}},
  "config": {"sort-packages": true, "allow-plugins": false}
}
