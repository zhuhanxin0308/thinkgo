{
    "app_name": "ThinkGo",
    "app_env": "development",
    "app_debug": false,
    "app_trace": false,
    "session_enable": false,
    "default_timezone": "Asia/Shanghai",
    "default_lang": "zh-cn",
    "server": {
        "host": "0.0.0.0",
        "port": 80,
        "http3": false,
        "trusted_proxies": [],
        "tls": {
            "enable": false,
            "cert_file": "./runtime/cert.pem",
            "key_file": "./runtime/key.pem"
        }
    },
    "compression": {
        "enable": true,
        "min_size": 1024,
        "levels": {
            "gzip": 5,
            "br": 4,
            "zstd": 4,
            "deflate": 5
        }
    }
}
