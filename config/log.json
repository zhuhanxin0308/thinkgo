{
    "default": "file",
    "channels": {
        "file": {
            "type": "file",
            "path": "./runtime/log",
            "level": [
                "info",
                "warning",
                "error",
                "debug",
                "sql"
            ],
            "max_file_size": 10485760,
            "retention_days": 30,
            "max_files": 100,
            "max_total_size": 1073741824
        }
    }
}
