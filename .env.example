# App
APP_DEBUG=false
APP_TRACE=false
APP_METRICS_ENABLE=false
APP_CSRF_ENABLE=false
APP_DEFAULT_TIMEZONE=Asia/Shanghai

# Security secrets (production: inject at least 32 random bytes)
COOKIE_SECRET=
CSRF_SECRET=

# Server
SERVER_DOMAIN=http://127.0.0.1:8081
SERVER_HOST=0.0.0.0
SERVER_PORT=8081
SERVER_HTTP3=false
SERVER_TLS_ENABLE=false
SERVER_TLS_CERT=./runtime/cert.pem
SERVER_TLS_KEY=./runtime/key.pem
SERVER_TRUSTED_PROXIES=

# Database
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=thinkgo
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SECONDS=300

# Graph Neo4j
GRAPH_NEO4J_URI=neo4j://127.0.0.1:7687
GRAPH_NEO4J_HOST=127.0.0.1
GRAPH_NEO4J_PORT=7687
GRAPH_NEO4J_USER=neo4j
GRAPH_NEO4J_PASS=your_neo4j_password
GRAPH_NEO4J_DATABASE=
GRAPH_QUERY_TIMEOUT_SECONDS=8
GRAPH_SEARCH_MAX_CONCURRENCY=2
