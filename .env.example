# App
APP_DEBUG=false
APP_TRACE=false

# Server
SERVER_DOMAIN=http://127.0.0.1:8081
SERVER_HOST=0.0.0.0
SERVER_PORT=8081
SERVER_HTTP3=false
SERVER_TLS_ENABLE=false
SERVER_TLS_CERT=./runtime/cert.pem
SERVER_TLS_KEY=./runtime/key.pem
SERVER_TRUSTED_PROXIES=

# Database
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=thinkgo
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SECONDS=300

# Graph Neo4j
GRAPH_NEO4J_URI=neo4j://127.0.0.1:7687
GRAPH_NEO4J_HOST=127.0.0.1
GRAPH_NEO4J_PORT=7687
GRAPH_NEO4J_USER=neo4j
GRAPH_NEO4J_PASS=your_neo4j_password
GRAPH_NEO4J_DATABASE=
GRAPH_QUERY_TIMEOUT_SECONDS=8
GRAPH_SEARCH_MAX_CONCURRENCY=2

# Wechat OA
WECHAT_OA_APPID=your_oa_appid
WECHAT_OA_SECRET=your_oa_secret
WECHAT_OA_TOKEN=your_oa_callback_token
WECHAT_OA_ENCODING_AES_KEY=your_oa_encoding_aes_key
WECHAT_OA_REPLY_SYSTEM_PROMPT=You are a WeChat OA assistant. Reply in concise Chinese.

# OpenAI Compatible
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=your_openai_compatible_api_key
OPENAI_API_KEYS=
OPENAI_MODEL=google/gemma-4-31b-it
AI_CHAT_SYSTEM_PROMPT=You are a professional Chinese AI assistant.
AI_CHAT_TIMEOUT_SECONDS=45
AI_CHAT_MAX_RETRIES=2
AI_CHAT_SESSION_TTL_SECONDS=86400
AI_CHAT_SESSION_MAX_MESSAGES=40
AI_CHAT_RETRY_INTERVAL_MS=200

# Wechat Mini
WECHAT_MINI_APPID=your_mini_appid
WECHAT_MINI_SECRET=your_mini_secret

# API Security
API_SECURITY_ENABLE_SIGN=true
API_SECURITY_ENABLE_ENCRYPT=false
API_SECURITY_DEBUG=false
API_SECURITY_VERIFY_PUBLIC_KEY=./runtime/pub.pem
API_SECURITY_AES_KEY=your_aes_key
API_SECURITY_AES_SN=your_aes_sn
