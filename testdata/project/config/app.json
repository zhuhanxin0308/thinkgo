{
    "app_namespace": "",
    "with_route": true,
    "public_path": "public",
    "default_app": "index",
    "default_timezone": "Asia/Shanghai",
    "app_map": {},
    "domain_bind": {},
    "deny_app_list": [],
    "server": {
        "domain": "https://localhost",
        "host": "0.0.0.0",
        "port": 8000,
        "allowed_hosts": [],
        "trusted_proxies": [],
        "tls": {
            "enable": false,
            "cert_file": "./runtime/cert.pem",
            "key_file": "./runtime/key.pem"
        },
        "http3": false,
        "read_header_timeout_ms": 2000,
        "read_timeout_ms": 10000,
        "write_timeout_ms": 15000,
        "idle_timeout_ms": 60000,
        "shutdown_timeout_ms": 5000,
        "request_end_timeout_ms": 2000,
        "max_outstanding_requests": 2048,
        "max_header_bytes": 1048576,
        "max_body_bytes": 10485760,
        "multipart_max_memory_mb": 32
    },
    "compression": {
        "enable": false,
        "min_size": 1024,
        "levels": {}
    },
    "exception_tmpl": "",
    "error_message": "页面错误！请稍后再试～",
    "show_error_msg": false
}
